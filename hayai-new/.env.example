# HAYAI v2 Environment Template (Versioned)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hayai
DB_USER=your_db_user
DB_PASSWORD=your_db_password

DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# When false, the 'sentiment' batch job skips DeepSeek analysis (news are still
# downloaded by the 'news' job). Set to false while away to avoid token costs.
NEWS_LLM_ENABLED=true

HAYAI_ROOT=/opt/hayai
