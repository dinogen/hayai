# HAYAI v2 Environment Template (Versioned)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hayai
DB_USER=your_db_user
DB_PASSWORD=your_db_password

DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# When false, the 'sentiment' batch job skips DeepSeek analysis (news are still
# downloaded by the 'news' job). Set to false while away to avoid token costs.
NEWS_LLM_ENABLED=true

HAYAI_ROOT=/opt/hayai

# Auth (single user, cookie-based session)
# AUTH_SESSION_SECRET must be a long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password
AUTH_SESSION_SECRET=your-random-secret-hex
# Session cookie validity in seconds (default 43200 = 12h)
AUTH_SESSION_MAX_AGE=43200
